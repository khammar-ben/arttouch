# Supabase : bouton « Connect » du projet → onglet ORMs → Prisma
# Connexion poolée (Transaction pooler, port 6543), utilisée par le site
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Connexion directe (Session pooler, port 5432), utilisée par prisma db push
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Mot de passe de l'espace /admin
ADMIN_PASSWORD="change-moi"

# Numéro WhatsApp de la boutique, format international sans + (ex. 212612345678)
NEXT_PUBLIC_WHATSAPP_NUMBER="212600000000"
