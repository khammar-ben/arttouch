# Supabase : bouton « Connect » du projet → onglet ORMs → Prisma
# Connexion poolée (Transaction pooler, port 6543), utilisée par le site
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Connexion directe (Session pooler, port 5432), utilisée par prisma db push
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Mot de passe de l'espace /admin
ADMIN_PASSWORD="change-moi"

# Envoi des photos produits depuis l'atelier (Supabase → Project Settings → API Keys → clé secrète / service_role).
# Secrète : jamais dans le code ni dans une variable NEXT_PUBLIC_. L'URL du projet se déduit de DATABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=""

# Numéro WhatsApp de la boutique, format international sans + (ex. 212612345678)
NEXT_PUBLIC_WHATSAPP_NUMBER="212600000000"
